# Copie este arquivo para ".env". NUNCA commite o ".env" real.
#
# O orquestrador NÃO usa AWS — as credenciais ficam nas folhas de Bedrock.

# --- Endereços das folhas ---
# Em dev local (cada folha no seu uvicorn): use localhost:<porta>.
# Em docker-compose: troque por http://<nome-do-servico>:<porta>.
GUARDRAIL_URL=http://localhost:8001
TRIAGE_URL=http://localhost:8002
RAG_URL=http://localhost:8003
RISK_URL=http://localhost:8004
CONSOLIDATE_URL=http://localhost:8005
REPORT_WRITER_URL=http://localhost:8006
TRACES_URL=http://localhost:8007

# Timeout (s) de cada chamada HTTP a uma folha.
HTTP_TIMEOUT=30

# --- Auth ---
# Se as folhas exigirem X-API-Key, use a MESMA chave aqui — ela é repassada
# a cada folha. Se o orquestrador tiver API_KEY, seus endpoints também a exigem.
API_KEY=

# --- Batch / AIMD ---
BATCH_MAX_WORKERS=5
BATCH_RATE_LIMIT_DELAY=0.0
BATCH_MAX_RETRIES=2
BATCH_MAX_PASSES=3
BATCH_RETRY_DELAY=15.0
