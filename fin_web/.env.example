# Copie este arquivo para ".env". NUNCA commite o ".env" real.
#
# O fin_web NÃO usa AWS e fala SÓ com o fin_orchestrator.

# Endereço do orquestrador.
# Dev local: http://localhost:8000 · Compose: http://fin_orchestrator:8000
ORCHESTRATOR_URL=http://localhost:8000

# Timeout (s) de cada chamada ao orquestrador. O /batch pode ser longo.
HTTP_TIMEOUT=120

# Se o orquestrador exigir X-API-Key, use a MESMA chave — ela é repassada.
API_KEY=

# Recorde do joguinho da tela de espera do batch (JSON local, opcional).
# SNAKE_RECORD_PATH=app/assets/snake_record.json
