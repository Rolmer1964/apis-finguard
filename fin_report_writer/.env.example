# Copie este arquivo para ".env". NUNCA commite o ".env" real.
#
# Este serviço é determinístico e NÃO usa AWS — nenhuma credencial é necessária.

# --- Artefatos ---
# Diretório onde os relatórios (.json/.meta.json/.csv/.md) são gravados e
# de onde GET /output/{filename} os serve. Em dev local, um caminho relativo.
OUTPUT_DIR=./output

# --- API ---
# Se definido, os endpoints de escrita exigem o header "X-API-Key" com este valor.
# Deixe em branco para desabilitar a autenticação em dev local.
API_KEY=
