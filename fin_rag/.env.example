# Copie este arquivo para ".env". NUNCA commite o ".env" real.

# --- AWS ---
AWS_REGION=us-east-1
AWS_PROFILE=finguard-bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Bedrock (embeddings) ---
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIM=1024

# --- RAG ---
# Pasta com a Política Interna (PDF/MD/TXT). Em dev local, relativo ao CWD.
RAG_DOCS_DIR=assets/docs
# Pasta do índice FAISS + manifest (persistente; regenerável via /v1/rag/ingest).
RAG_INDEX_DIR=assets/index
RAG_TOP_K=4
RAG_CHUNK_CHARS=1000
RAG_CHUNK_OVERLAP=200

# No startup: 1 embedding real para checar conectividade (aborta se falhar).
PROBE_ON_STARTUP=true
# No startup: dispara a ingestão incremental em background.
INGEST_ON_STARTUP=true

# --- API ---
# Se definido, os endpoints de escrita/consulta exigem o header "X-API-Key".
API_KEY=
