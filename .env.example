# apis_finguard — configuração do stack (docker compose).
# Copie para ".env" e preencha. NUNCA commite o ".env" real.
#
# Só o que varia entre ambientes fica aqui. O cabeamento entre serviços
# (URLs das folhas, diretórios de volume) está fixo no docker-compose.yml.

# ─────────────────────────────────────────────────────────────────────────────
# AWS — necessário para as 4 folhas de Bedrock (guardrail, triage, rag, risk).
# ─────────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Opção A) perfil de ~/.aws/config (SSO ou assume-role). Faça o login no host
# ANTES de subir (ex.: aws sso login --profile finguard-bedrock) e aponte
# HOST_AWS_DIR para o seu ~/.aws.
AWS_PROFILE=
HOST_AWS_DIR=./.aws

# Opção B) credenciais estáticas (ignora AWS_PROFILE). Preencha as 3 (a de
# sessão é obrigatória para credenciais temporárias de SSO/STS).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# ECR — só usado em produção (docker-compose.prod.yml), para puxar as imagens
# publicadas por tools/publish_ecr.sh em vez de buildar local.
# ─────────────────────────────────────────────────────────────────────────────
ECR_REGISTRY=<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com

# ─────────────────────────────────────────────────────────────────────────────
# Bedrock Guardrails — OBRIGATÓRIO. Sem um ID válido o fin_guardrail não sobe
# (e, por dependência, o orquestrador e o fin_web ficam parados).
# Veja em Amazon Bedrock > Guardrails. Working draft = versão "DRAFT".
# ─────────────────────────────────────────────────────────────────────────────
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT
# Guardrail separado para a saída (opcional; vazio = reusa o de cima).
GUARDRAIL_ID_OUTPUT=
GUARDRAIL_VERSION_OUTPUT=DRAFT

# ─────────────────────────────────────────────────────────────────────────────
# Modelos Bedrock (defaults já batem com o projeto; só mude se precisar).
# ─────────────────────────────────────────────────────────────────────────────
BEDROCK_MODEL_TRIAGE=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_RISK=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Se definida, fin_triage e fin_risk ignoram o Bedrock e chamam a Anthropic
# API direto com esta chave (contorna o gate de acesso a modelos Claude no
# Bedrock enquanto a conta não tem aprovação da AWS). fin_guardrail continua
# sempre no Bedrock (guardrails não tem equivalente na Anthropic API).
# Em produção, prefira deixar esta linha vazia e usar
# ANTHROPIC_API_KEY_SSM_PARAM abaixo — evita ter a chave em texto puro no
# .env da instância.
ANTHROPIC_API_KEY=

# Alternativa a ANTHROPIC_API_KEY acima: nome de um parâmetro SecureString no
# SSM Parameter Store de onde fin_triage/fin_risk buscam a chave uma única
# vez, no startup (nunca por requisição). Só é usado quando ANTHROPIC_API_KEY
# acima estiver vazia. Requer que a role/credencial da instância tenha
# ssm:GetParameter + kms:Decrypt no parâmetro.
ANTHROPIC_API_KEY_SSM_PARAM=

# ─────────────────────────────────────────────────────────────────────────────
# Embedding do fin_rag — modelo local (sentence-transformers), sem AWS.
# ─────────────────────────────────────────────────────────────────────────────
EMBED_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384

# ─────────────────────────────────────────────────────────────────────────────
# Startup das folhas de Bedrock.
#   PROBE_ON_STARTUP=true  -> triage/rag/risk fazem 1 chamada real no boot e
#                             abortam se a AWS falhar (recomendado em prod).
#   false -> sobem mesmo sem AWS e só falham (502) quando chamadas.
#   (o fin_guardrail SEMPRE faz o probe — não tem essa flag.)
#   INGEST_ON_STARTUP=true -> fin_rag ingere a Política Interna no boot.
# ─────────────────────────────────────────────────────────────────────────────
PROBE_ON_STARTUP=false
INGEST_ON_STARTUP=true

# ─────────────────────────────────────────────────────────────────────────────
# RAG (chunking / retrieval).
# ─────────────────────────────────────────────────────────────────────────────
RAG_TOP_K=4
RAG_CHUNK_CHARS=1000
RAG_CHUNK_OVERLAP=200

# ─────────────────────────────────────────────────────────────────────────────
# Auth — se definida, TODOS os serviços exigem o header X-API-Key com este
# valor, e o orquestrador/fin_web a repassam adiante. Vazio = sem auth.
# ─────────────────────────────────────────────────────────────────────────────
API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Orquestrador — batch com controle adaptativo (AIMD) + timeout HTTP.
# ─────────────────────────────────────────────────────────────────────────────
HTTP_TIMEOUT=30
WEB_HTTP_TIMEOUT=120
BATCH_MAX_WORKERS=5
BATCH_RATE_LIMIT_DELAY=0.0
BATCH_MAX_RETRIES=2
BATCH_MAX_PASSES=3
BATCH_RETRY_DELAY=15.0
