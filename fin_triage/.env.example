# Copie este arquivo para ".env". NUNCA commite o ".env" real.

# --- AWS ---
AWS_REGION=us-east-1
# Profile de ~/.aws/config a usar (ex.: profile SSO ou de assume-role).
# Em dev local com SSO, aponte para o profile com acesso ao Bedrock.
# Deixe VAZIO na EC2 — lá vale a IAM role da instância (IMDS).
AWS_PROFILE=finguard-bedrock
# Só preencha abaixo para forçar credenciais estáticas (ignora AWS_PROFILE).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Bedrock ---
# Modelo de triagem (Haiku). Precisa estar habilitado na conta/região.
BEDROCK_MODEL_TRIAGE=us.anthropic.claude-haiku-4-5-20251001-v1:0

# No startup, faz 1 chamada real de 1 token ao Bedrock e aborta se falhar.
# Custa ~1 token. Deixe "false" para pular (CI, ou boot sem AWS).
PROBE_ON_STARTUP=true

# --- API ---
# Se definido, os endpoints exigem o header "X-API-Key" com este valor.
API_KEY=
