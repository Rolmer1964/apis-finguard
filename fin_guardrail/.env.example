# Copie este arquivo para ".env" e preencha com seus valores.
# NUNCA commite o arquivo ".env" real no git.

# --- AWS ---
AWS_REGION=us-east-1
# Profile de ~/.aws/config a usar (ex.: profile SSO ou de assume-role).
# Em dev local com SSO, aponte para o profile que tem acesso ao Bedrock.
# Deixe VAZIO na EC2 — lá vale a IAM role da instância (IMDS).
AWS_PROFILE=finguard-bedrock
# Só preencha abaixo se quiser forçar credenciais estáticas (ignora AWS_PROFILE).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Bedrock Guardrails ---
# OBRIGATÓRIO. ID do guardrail visto em Amazon Bedrock > Guardrails >
# finguard-guardrail (ex.: abcd1234efgh). Working draft = versão "DRAFT".
# Sem este valor a API não sobe. Não há fallback local: se a chamada ao
# Bedrock falhar, os endpoints retornam HTTP 502.
GUARDRAIL_ID=abcd1234efgh
GUARDRAIL_VERSION=DRAFT

# Opcional: guardrail separado para OUTPUT. Se vazio, reusa o GUARDRAIL_ID acima.
GUARDRAIL_ID_OUTPUT=
GUARDRAIL_VERSION_OUTPUT=DRAFT

# --- API ---
# Se definido, os endpoints exigem o header "X-API-Key" com este valor.
API_KEY=
