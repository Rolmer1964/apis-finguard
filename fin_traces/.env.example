# Copie este arquivo para ".env". NUNCA commite o ".env" real.
#
# Este serviço é determinístico e NÃO usa AWS — nenhuma credencial é necessária.

# --- Persistência (opcional) ---
# Se definido, o log de execução é despejado neste arquivo (JSON) a cada
# escrita e recarregado no startup — sobrevive a restart do processo.
# Deixe em branco para manter o log só em memória.
TRACES_PERSIST_PATH=

# --- API ---
# Se definido, os endpoints de escrita (POST/DELETE/recompose) exigem o header
# "X-API-Key" com este valor. Deixe em branco para desabilitar em dev local.
API_KEY=
